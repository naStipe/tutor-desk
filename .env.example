# ==============================================================================
# TutorDesk Environment Variables Example
# ==============================================================================
# Copy this file to .env.local for local development.
# DO NOT commit .env or real production secrets to version control.
# ==============================================================================

# Public application URL used for Supabase email-confirmation redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Hosted Supabase project values. The publishable key is safe for browser use because RLS
# enforces access; never place a secret or service-role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL="https://cmlvtnjoynffrznyelym.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace-with-project-key"

# ------------------------------------------------------------------------------
# Email notifications (TD-020). OFF by default; see docs/EMAIL_SETUP.md before enabling.
# ------------------------------------------------------------------------------
# Master switch. Only the exact value "true" enables sending; anything else keeps it off.
EMAIL_NOTIFICATIONS_ENABLED="false"
# Resend API key (server-only) and a sender address on a domain verified in Resend.
RESEND_API_KEY="re_replace-with-resend-api-key"
EMAIL_FROM="TutorDesk <notifications@example.com>"
# Shared secret the cron route requires as "Authorization: Bearer <secret>". Use a long random
# value (for example `openssl rand -hex 32`); Vercel Cron sends it automatically when the
# CRON_SECRET environment variable is set on the project.
CRON_SECRET="replace-with-a-long-random-secret"
# Service-role key (server-only, bypasses RLS). Used ONLY by the notification cron/send paths.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
