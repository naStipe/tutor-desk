# ==============================================================================
# TutorDesk Environment Variables Example
# ==============================================================================
# Copy this file to .env.local for local development.
# DO NOT commit .env or real production secrets to version control.
# ==============================================================================

# Node Environment
NODE_ENV="development"

# Application Base URL
# The publicly accessible URL where this application is hosted.
# Used for authentication callbacks, absolute links, and emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# PostgreSQL Database Connection
# Standard PostgreSQL connection URI used by Drizzle ORM and migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tutordesk"

# Better Auth Configuration
# BETTER_AUTH_SECRET: Secret key used to sign and encrypt session tokens (min 32 chars).
BETTER_AUTH_SECRET="change-this-to-a-secure-random-secret-key-at-least-32-chars"
# BETTER_AUTH_URL: Base URL of the authentication server (typically matches app URL).
BETTER_AUTH_URL="http://localhost:3000"
