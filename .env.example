# ==============================================================================
# TutorDesk Environment Variables Example
# ==============================================================================
# Copy this file to .env.local for local development.
# DO NOT commit .env or real production secrets to version control.
# ==============================================================================

# PostgreSQL Database Connection
# These credentials are for the development-only compose.yaml service.
DATABASE_URL="postgresql://tutordesk:tutordesk_dev_password@localhost:5432/tutordesk"

# Better Auth Configuration
# BETTER_AUTH_SECRET: Secret key used to sign and encrypt session tokens (min 32 chars).
BETTER_AUTH_SECRET="change-this-to-a-secure-random-secret-key-at-least-32-chars"
# BETTER_AUTH_URL: Public base URL of this TutorDesk deployment.
BETTER_AUTH_URL="http://localhost:3000"
