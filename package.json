{
  "name": "tutordesk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:auth:hosted": "node scripts/verify-hosted-auth.mjs",
    "test:e2e:install": "playwright install chromium --only-shell",
    "db:migrations": "supabase migration list",
    "db:push:dry": "supabase db push --linked --dry-run",
    "db:push": "supabase db push --linked",
    "db:test:hosted": "supabase db query --linked --file supabase/tests/tutor_profile_rls.sql",
    "db:test:hosted:students": "supabase db query --linked --file supabase/tests/student_rls.sql",
    "db:test:hosted:lessons": "supabase db query --linked --file supabase/tests/lesson_rls.sql",
    "db:test:hosted:homework": "supabase db query --linked --file supabase/tests/homework_rls.sql",
    "db:test:hosted:subjects": "supabase db query --linked --file supabase/tests/subject_rls.sql",
    "db:test:hosted:rates": "supabase db query --linked --file supabase/tests/student_subject_rate_rls.sql",
    "db:types": "supabase gen types --project-id cmlvtnjoynffrznyelym --schema public",
    "db:types:check": "node scripts/check-generated-types.mjs",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@vercel/speed-insights": "^2.0.0",
    "motion": "^13.4.0",
    "next": "^15.5.25",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "supabase": "2.117.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vitest": "^4.1.11"
  }
}
